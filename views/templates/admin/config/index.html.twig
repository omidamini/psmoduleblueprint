{% extends '@Modules/psmoduleblueprint/views/templates/admin/assets.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block content %}
    <div class="panel">
        <div class="panel-heading">
            {% include '@Modules/psmoduleblueprint/views/templates/admin/menu_panel_heading.html.twig' with {'page_section': 'Custom Example'} %}
        </div>
        <div class="panel-body form-horizontal">
                {% include '@Modules/psmoduleblueprint/views/templates/admin/menus.html.twig' %}
                <hr>
                <div class="row justify-content-center">
                     <div class="col-md-12">
                        <div class="card">
                            <div class="card-body">
                                {% include '@Modules/psmoduleblueprint/views/templates/admin/search.html.twig' %}
                            </div>
                        </div>    
                    </div>    
                    <div class="col-md-12">
                        {% if welcome_msg is defined %}
                            <div class="alert alert-info" role="alert">
                                {{ welcome_msg|raw }}
                            </div>
                        {% endif %}
                    </div>
                </div>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
{% endblock %}