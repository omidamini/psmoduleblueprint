# Apache 2.2
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|sh)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
